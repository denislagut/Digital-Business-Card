generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model Profile {
  id             String          @id @default(uuid())
  fullName       String
  headline       String
  location       String
  summary        String
  email          String
  phone          String?
  githubUrl      String?
  telegramUrl    String?
  resumeAsset    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  skills         Skill[]
  projects       Project[]
  experiences    Experience[]
  educations     Education[]
  certifications Certification[]
}

model Skill {
  id        String     @id @default(uuid())
  name      String
  category  String
  level     SkillLevel
  years     Float?
  profileId String
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  url         String?
  sourceUrl   String?
  highlights  String[]
  stack       String[]
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Experience {
  id          String    @id @default(uuid())
  company     String
  role        String
  startedAt   DateTime
  endedAt     DateTime?
  description String
  stack       String[]
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Education {
  id          String    @id @default(uuid())
  institution String
  degree      String
  field       String
  startedAt   DateTime?
  endedAt     DateTime?
  description String?
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Certification {
  id            String    @id @default(uuid())
  title         String
  issuer        String
  issuedAt      DateTime?
  credentialUrl String?
  assetUrl      String?
  description   String?
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

enum SkillLevel {
  FAMILIAR
  PRACTICAL
  PROFICIENT

  @@map("SkillUsageLevel")
}
