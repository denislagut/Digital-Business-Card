generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model Profile {
  id           String       @id @default(uuid())
  fullName     String
  headline     String
  location     String
  summary      String
  email        String
  phone        String?
  githubUrl    String?
  telegramUrl  String?
  resumeAsset  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  skills       Skill[]
  projects     Project[]
  experiences  Experience[]
}

model Skill {
  id        String    @id @default(uuid())
  name      String
  category  String
  level     SkillLevel
  years     Float?
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  url         String?
  sourceUrl   String?
  highlights  String[]
  stack       String[]
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Experience {
  id          String    @id @default(uuid())
  company     String
  role        String
  startedAt   DateTime
  finishedAt  DateTime?
  description String
  stack       String[]
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

enum SkillLevel {
  BEGINNER
  JUNIOR
  JUNIOR_PLUS
  MIDDLE
}
